<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Temporary native controls. The user owns the final UI/UX direction. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/prototype" android:textColor="#FFFFFF" android:textSize="14sp" />
        <Button android:id="@+id/assist" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/assist_on" android:textAllCaps="false" />
        <Button android:id="@+id/flip" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/flip" android:textAllCaps="false" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.camera.view.PreviewView android:id="@+id/preview"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:contentDescription="Camera viewfinder" />
        <dev.cameracompositor.GuideOverlay android:id="@+id/overlay"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <Button android:id="@+id/access" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_gravity="center" android:text="@string/retry" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/guidance" android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/waiting"
        android:textSize="17sp" android:textColor="#FFFFFF" android:accessibilityLiveRegion="polite" />
    <RadioGroup android:id="@+id/targets" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center" android:checkedButton="@id/target_right">
        <RadioButton android:id="@+id/target_left" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/target_left" android:textSize="13sp" />
        <RadioButton android:id="@+id/target_center" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/target_center" android:textSize="13sp" />
        <RadioButton android:id="@+id/target_right" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/target_right" android:textSize="13sp" />
    </RadioGroup>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
        android:gravity="center" android:paddingHorizontal="12dp">
        <Button android:id="@+id/gallery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
            android:text="@string/gallery" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/capture" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp"
            android:text="@string/capture" android:textAllCaps="false" android:enabled="false" />
    </LinearLayout>
    <TextView android:id="@+id/telemetry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="8dp" android:text="@string/telemetry"
        android:textSize="11sp" android:textColor="#BDBDBD" />
</LinearLayout>

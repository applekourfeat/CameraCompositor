<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- Functional layout only. The owner leads final visual design. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <Button android:id="@+id/composition_style" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:minWidth="0dp" android:maxLines="2"
            android:text="@string/style_thirds" android:textAllCaps="false" android:textSize="14sp" />
        <Button android:id="@+id/flip" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/flip" android:textAllCaps="false" />
        <Button android:id="@+id/settings" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/options" android:textAllCaps="false" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <dev.cameracompositor.ViewfinderFrame android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_gravity="center">
            <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent"
                android:layout_height="match_parent" android:contentDescription="@string/viewfinder" />
            <dev.cameracompositor.GuideOverlay android:id="@+id/overlay" android:layout_width="match_parent"
                android:layout_height="match_parent" android:importantForAccessibility="no" />
            <TextView android:id="@+id/shutter_countdown" android:layout_width="96dp"
                android:layout_height="96dp" android:layout_gravity="center" android:gravity="center"
                android:background="#99000000" android:textColor="#FFFFFF" android:textSize="52sp"
                android:importantForAccessibility="no" android:visibility="gone" />
            <Button android:id="@+id/access" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_gravity="center" android:text="@string/retry" android:visibility="gone" />
        </dev.cameracompositor.ViewfinderFrame>
    </FrameLayout>
    <TextView android:id="@+id/guidance" android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/waiting"
        android:textSize="16sp" android:textColor="#FFFFFF" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center">
        <Button android:id="@+id/find_shot" android:layout_width="wrap_content" android:layout_height="52dp"
            android:text="@string/find_shot" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/automatic" android:layout_width="wrap_content" android:layout_height="52dp"
            android:text="@string/auto_on" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/cancel" android:layout_width="wrap_content" android:layout_height="52dp"
            android:text="@string/cancel" android:textAllCaps="false" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
        android:gravity="center" android:paddingHorizontal="12dp">
        <Button android:id="@+id/gallery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
            android:text="@string/gallery" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/capture" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp"
            android:text="@string/capture" android:textAllCaps="false" android:enabled="false" />
    </LinearLayout>
    <TextView android:id="@+id/telemetry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="8dp" android:text="@string/telemetry"
        android:textSize="11sp" android:textColor="#BDBDBD" />
</LinearLayout>
